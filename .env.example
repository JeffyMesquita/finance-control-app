# Vercel/Render frontend configuration. Values are build-time inputs for Next.
NEXT_PUBLIC_BASE_URL=https://your-frontend-domain.example
# Server-only origin used by next.config.mjs to proxy /api/backend/* to Nest.
BACKEND_API_ORIGIN=https://your-backend-domain.example
# Comma-separated rollout domains. This default keeps the deployed app on the Nest API.
# Temporarily narrow it only when rolling a domain back in staging.
NEXT_PUBLIC_NEST_DOMAINS=profile,accounts,categories,transactions,dashboard,reports,export,goals,savings-boxes,investments,feedback,referrals,admin

NEXT_PUBLIC_RECAPTCHA_SITE_KEY=recaptcha_site_key
NEXT_PUBLIC_PIX_KEY=example-uuid-0000-0000-0000-000000000000

# Do not put backend secrets in the frontend environment:
# SUPABASE_SERVICE_ROLE_KEY, RECAPTCHA_SECRET_KEY and RESEND_API_KEY belong only
# to the Nest service. The current production build does not require public
# Supabase variables while the legacy routes remain disabled.
